{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyLooper",
  "version": "0.2.0",
  "identifier": "com.rhythmicdias.keylooper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "KeyLooper",
        "width": 1080,
        "height": 768,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxQjhFREJBN0FBQTQxOApSV1FZcEtxbjI0NGJEVFMvQ1dDaUQzSloxbTdCWHhtRzF1M3BORk1BaXNmNWVmMDFheVRsTUZ0UQo=",
      "endpoints": [
        "https://github.com/RhythmicDias/KeyLooper/releases/latest/download/latest.json"
      ]
    }
  }
}
